# Copy to .env and fill in. Never commit .env.
# Postgres (backend + UI API read PG_*; retrieval_agent reads AZURE_PG_* -- keep both equal until unified)
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SSLMODE=require
AZURE_PG_HOST=
AZURE_PG_PORT=5432
AZURE_PG_DATABASE=
AZURE_PG_USER=
AZURE_PG_PASSWORD=
AZURE_PG_SSLMODE=require
# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=   # backend; must support dimensions=1536
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=        # retrieval_agent (same deployment)
EMBEDDING_DIMENSIONS=3072
# osTicket (source of truth for tickets) -- read-only MySQL access used by the sync
OSTICKET_URL=http://127.0.0.1:8081
OSTICKET_DB_HOST=127.0.0.1
OSTICKET_DB_PORT=3306
OSTICKET_DB_NAME=osticket
OSTICKET_DB_USER=
OSTICKET_DB_PASSWORD=
OSTICKET_SYNC_INTERVAL=60   # seconds; leave empty to sync only via POST /api/osticket/sync
